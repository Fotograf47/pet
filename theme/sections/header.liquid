{% comment %}
  HEADER COMPLET — petshop-constanta.ro

  Sigla se poate seta din Shopify Admin → Online Store → Customize → Header → Logo.
  Dacă nu e setată, se folosește fallback-ul din assets/petshop-constanta-sigla.avif.
{% endcomment %}

<div class="promo-bar-wrap" id="promo-bar-wrap">
  <div class="promo-bar" style="background: {{ section.settings.promo_bg }}; color: {{ section.settings.promo_color }};">
    {% if section.settings.promo_link != blank %}
      <a href="{{ section.settings.promo_link }}" style="color: {{ section.settings.promo_color }}; text-decoration: none;">
        {{ section.settings.promo_text }}
      </a>
    {% else %}
      {{ section.settings.promo_text }}
    {% endif %}
    <button class="promo-bar__close" onclick="closePromo()" aria-label="Închide">✕</button>
  </div>
</div>

<header class="site-header" id="site-header">
  <div class="site-header__inner page-width">

    <!-- Hamburger mobil -->
    <button class="hamburger-btn" id="hamburger-btn" onclick="toggleMobileMenu()" aria-label="Meniu">
      <span></span><span></span><span></span>
    </button>

    <!-- Logo -->
    <a href="/" class="site-header__logo" aria-label="Petshop Constanta - Acasă">
      {% if section.settings.logo != blank %}
        <img
          src="{{ section.settings.logo | image_url: width: 300, height: 100, crop: 'center' }}"
          srcset="
            {{ section.settings.logo | image_url: width: 150, height: 50, crop: 'center' }} 150w,
            {{ section.settings.logo | image_url: width: 300, height: 100, crop: 'center' }} 300w
          "
          alt="{{ shop.name }}"
          width="150"
          height="50"
          loading="eager"
        >
      {% else %}
        {%- comment -%} Fallback: sigla din assets {%- endcomment -%}
        <img
          src="{{ 'petshop-constanta-sigla.avif' | asset_url }}"
          alt="{{ shop.name }}"
          width="150"
          height="50"
          loading="eager"
          style="object-fit: contain;"
        >
      {% endif %}
    </a>

    <!-- Search bar -->
    <div class="site-header__search" id="predictive-search">
      <form action="/search" method="get" role="search" autocomplete="off">
        <input type="hidden" name="type" value="product">
        <input
          type="search"
          name="q"
          placeholder="Caută produse, branduri, animale..."
          aria-label="Căutare"
          autocomplete="off"
          id="header-search-input"
          role="combobox"
          aria-expanded="false"
          aria-controls="predictive-search-results"
          aria-autocomplete="list"
        >
        <button type="submit" aria-label="Caută">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
            <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
          </svg>
        </button>
      </form>
      <div id="predictive-search-results" class="predictive-search__results" hidden role="listbox"></div>
    </div>

    <!-- Acțiuni dreapta -->
    <div class="site-header__actions">
      <!-- Cont -->
      <a href="/account" class="header-action" aria-label="Contul meu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <span>Cont</span>
      </a>

      <!-- Favorite (wishlist) -->
      <a href="/pages/wishlist" class="header-action" aria-label="Lista de dorințe">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span>Favorite</span>
      </a>

      <!-- Coș -->
      <a href="/cart" class="header-action header-action--cart" aria-label="Coș de cumpărături">
        <div class="cart-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <span class="cart-count" id="cart-count">{{ cart.item_count }}</span>
        </div>
        <span>Coș</span>
      </a>
    </div>
  </div>

  <!-- Mega menu desktop -->
  <nav class="desktop-nav" aria-label="Navigare principală">
    <div class="page-width">
      <ul class="desktop-nav__list">
        {% for link in linklists[section.settings.main_menu].links %}
          <li class="desktop-nav__item {% if link.links.size > 0 %}has-dropdown{% endif %}">
            <a href="{{ link.url }}" class="desktop-nav__link {% if link.active %}is-active{% endif %}">
              {{ link.title }}
              {% if link.links.size > 0 %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><polyline points="6 9 12 15 18 9"/></svg>
              {% endif %}
            </a>

            {% if link.links.size > 0 %}
              <div class="desktop-nav__dropdown">
                <div class="page-width">
                  <div class="dropdown-columns">
                    {% for child in link.links %}
                      <div class="dropdown-column">
                        <a href="{{ child.url }}" class="dropdown-column__title">{{ child.title }}</a>
                        {% if child.links.size > 0 %}
                          <ul class="dropdown-column__links">
                            {% for grandchild in child.links %}
                              <li>
                                <a href="{{ grandchild.url }}" class="{% if grandchild.active %}is-active{% endif %}">{{ grandchild.title }}</a>
                              </li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                      </div>
                    {% endfor %}
                  </div>
                </div>
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </nav>
</header>

<!-- Overlay mobil -->
<div class="mobile-overlay" id="mobile-overlay" onclick="toggleMobileMenu()"></div>

<!-- Drawer mobil -->
<div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
  <div class="mobile-drawer__header">
    <img src="{{ 'petshop-constanta-sigla.avif' | asset_url }}" alt="{{ shop.name }}" height="40" style="object-fit:contain;">
    <button onclick="toggleMobileMenu()" aria-label="Închide meniu" class="mobile-drawer__close">✕</button>
  </div>
  <ul class="mobile-drawer__list">
    {% for link in linklists[section.settings.main_menu].links %}
      <li class="mobile-drawer__item">
        {% if link.links.size > 0 %}
          <button class="mobile-drawer__link mobile-drawer__toggle" onclick="toggleDrawerSub(this)">
            {{ link.title }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <ul class="mobile-drawer__sub">
            {% for child in link.links %}
              <li><a href="{{ child.url }}" class="mobile-drawer__sub-link">{{ child.title }}</a></li>
            {% endfor %}
          </ul>
        {% else %}
          <a href="{{ link.url }}" class="mobile-drawer__link {% if link.active %}is-active{% endif %}">{{ link.title }}</a>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
  <div class="mobile-drawer__footer">
    <a href="/account" class="mobile-drawer__action"><span aria-hidden="true">👤</span> Contul meu</a>
    <a href="/pages/club" class="mobile-drawer__action"><span aria-hidden="true">⭐</span> Club fidelitate</a>
    <a href="/pages/contact" class="mobile-drawer__action"><span aria-hidden="true">📞</span> Contact</a>
    <a href="/pages/magazine" class="mobile-drawer__action"><span aria-hidden="true">🏪</span> Magazine</a>
  </div>
</div>

<script>
  // Promo bar
  function closePromo() {
    document.getElementById('promo-bar-wrap').style.display = 'none';
    sessionStorage.setItem('promo-closed', '1');
  }
  if (sessionStorage.getItem('promo-closed')) {
    document.getElementById('promo-bar-wrap').style.display = 'none';
  }

  // Mobile menu
  function toggleMobileMenu() {
    const drawer = document.getElementById('mobile-drawer');
    const overlay = document.getElementById('mobile-overlay');
    const isOpen = drawer.classList.contains('is-open');
    drawer.classList.toggle('is-open', !isOpen);
    overlay.classList.toggle('is-open', !isOpen);
    drawer.setAttribute('aria-hidden', isOpen);
    document.body.style.overflow = isOpen ? '' : 'hidden';
  }

  function toggleDrawerSub(btn) {
    const sub = btn.nextElementSibling;
    sub.classList.toggle('is-open');
    btn.classList.toggle('is-active');
  }

  // Update cart count via AJAX
  fetch('/cart.js')
    .then(r => r.json())
    .then(cart => {
      const el = document.getElementById('cart-count');
      if (el) el.textContent = cart.item_count;
    });

  // Predictive search cu debounce
  (function() {
    const input = document.getElementById('header-search-input');
    const resultsBox = document.getElementById('predictive-search-results');
    let debounceTimer;
    let currentQuery = '';

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str == null ? '' : String(str);
      return div.innerHTML;
    }

    function highlight(text, term) {
      const safeText = escapeHtml(text);
      const safeTerm = escapeHtml(term).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      return safeText.replace(new RegExp('(' + safeTerm + ')', 'ig'), '<mark>$1</mark>');
    }

    function renderResults(data, term) {
      const products = data.resources.results.products || [];
      if (!products.length) {
        resultsBox.innerHTML = `<p class="predictive-search__empty">Nu s-au găsit rezultate pentru „${escapeHtml(term)}”.</p>`;
      } else {
        resultsBox.innerHTML = products.slice(0, 6).map(p => `
          <a href="${p.url}" class="predictive-search__item" role="option">
            <img src="${p.featured_image ? p.featured_image.url : ''}" alt="" width="44" height="44" loading="lazy">
            <span class="predictive-search__item-title">${highlight(p.title, term)}</span>
            <span class="predictive-search__item-price">${p.price}</span>
          </a>
        `).join('') + `<a href="/search?q=${encodeURIComponent(term)}" class="predictive-search__view-all">Vezi toate rezultatele →</a>`;
      }
      resultsBox.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    }

    input.addEventListener('input', function() {
      const term = input.value.trim();
      currentQuery = term;
      clearTimeout(debounceTimer);

      if (term.length < 2) {
        resultsBox.hidden = true;
        input.setAttribute('aria-expanded', 'false');
        return;
      }

      debounceTimer = setTimeout(() => {
        fetch(`/search/suggest.json?q=${encodeURIComponent(term)}&resources[type]=product&resources[limit]=6&resources[options][fields]=title,product_type,variants.title,vendor`)
          .then(r => r.json())
          .then(data => {
            if (term === currentQuery) renderResults(data, term);
          })
          .catch(() => { resultsBox.hidden = true; });
      }, 300);
    });

    document.addEventListener('click', function(e) {
      if (!document.getElementById('predictive-search').contains(e.target)) {
        resultsBox.hidden = true;
        input.setAttribute('aria-expanded', 'false');
      }
    });

    input.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        resultsBox.hidden = true;
        input.setAttribute('aria-expanded', 'false');
      }
    });
  })();
</script>

<style>
.site-header__search { position: relative; }
.predictive-search__results { position: absolute; top: 100%; left: 0; right: 0; background: #fff; border: 1px solid var(--color-border, #e5e5e5); border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,.12); margin-top: 6px; z-index: 500; max-height: 400px; overflow-y: auto; }
.predictive-search__item { display: flex; align-items: center; gap: 10px; padding: 8px 12px; text-decoration: none; color: #222; border-bottom: 1px solid #f0f0f0; }
.predictive-search__item:hover, .predictive-search__item:focus-visible { background: #f7f7f7; }
.predictive-search__item img { width: 44px; height: 44px; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
.predictive-search__item-title { flex: 1; font-size: 13px; }
.predictive-search__item-title mark { background: #ffe9d6; color: inherit; }
.predictive-search__item-price { font-size: 13px; font-weight: 700; color: #e8650a; }
.predictive-search__empty { padding: 14px 12px; font-size: 13px; color: #777; }
.predictive-search__view-all { display: block; padding: 10px 12px; font-size: 13px; font-weight: 700; text-align: center; color: #e8650a; text-decoration: none; }
</style>

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (override assets)"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Meniu principal",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Text bară promoțională",
      "default": "🚚 LIVRARE GRATUITĂ la toate comenzile · Livrare în 1-3 zile lucrătoare"
    },
    {
      "type": "url",
      "id": "promo_link",
      "label": "Link bară promoțională (opțional)"
    },
    {
      "type": "color",
      "id": "promo_bg",
      "label": "Culoare fundal bară",
      "default": "#e8650a"
    },
    {
      "type": "color",
      "id": "promo_color",
      "label": "Culoare text bară",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
